{
  "name": "fixture-npm-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-npm-monorepo",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/fixture-app-a": {
      "resolved": "packages/app-a",
      "link": true
    },
    "node_modules/fixture-app-b": {
      "resolved": "packages/app-b",
      "link": true
    },
    "packages/app-a": {
      "name": "fixture-app-a",
      "version": "1.0.0"
    },
    "packages/app-b": {
      "name": "fixture-app-b",
      "version": "1.0.0"
    }
  }
}
